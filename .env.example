# Database — PostgreSQL (Neon, Supabase, or local). Required for production & for `pnpm build`.
# Example (Neon): postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth — use your real deploy URL in production (Vercel or custom domain)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Optional: set on Vercel if Auth.js reports host errors (usually not needed; app sets trustHost)
# AUTH_TRUST_HOST=true

# App (optional; some docs reference this)
APP_URL="http://localhost:3000"

# Public marketing site — “Apply for access” on the login page opens this URL (full URL to your registration form)
# NEXT_PUBLIC_MARKETING_REGISTER_URL="https://your-website.com/register"

# Shopify custom app (created via the Dev Dashboard, uses client credentials grant — no OAuth redirect needed)
SHOPIFY_SHOP_DOMAIN="your-shop.myshopify.com"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# Text messages (click & collect "ready to collect") via Twilio — from the Twilio console.
# TWILIO_FROM is a Twilio number (+447...) or an alphanumeric sender ID such as UnityCC.
# Until all three are set, orders are still marked ready and emailed, and admin sees why no text went.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="UnityCC"
